{
  "version": "V3",
  "model": {
    "name": "efficientnet_b0",
    "num_classes": 2,
    "pretrained": true,
    "freeze_features": true,
    "unfreeze_blocks": [
      6,
      7,
      8
    ],
    "dropout_rate": 0.3
  },
  "data": {
    "train_dir": "data/v3/splits/train",
    "val_dir": "data/v3/splits/validation",
    "test_dir": "data/v3/splits/test",
    "holdout_dir": "data/v3/generator_holdout_test",
    "metadata_csv": "data/v3/metadata/images.csv",
    "image_size": 224,
    "batch_size": 32,
    "num_workers": 2,
    "letterbox": true
  },
  "training": {
    "max_epochs": 3,
    "backbone_lr": 0.0001,
    "head_lr": 0.001,
    "weight_decay": 0.01,
    "early_stopping_patience": 2,
    "seed": 42,
    "device": "auto",
    "checkpoint_dir": "models/v3_final_candidate",
    "class_weights": "balanced"
  }
}