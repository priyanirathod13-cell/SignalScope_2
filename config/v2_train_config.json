{
  "version": "V2",
  "model": {
    "name": "efficientnet_b0",
    "num_classes": 2,
    "pretrained": true,
    "freeze_features": true,
    "unfreeze_top_block": true,
    "dropout_rate": 0.3
  },
  "data": {
    "train_dir": "data/v2/splits/train",
    "val_dir": "data/v2/splits/validation",
    "test_dir": "data/v2/splits/test",
    "metadata_csv": "data/v2/metadata/images.csv",
    "image_size": 224,
    "batch_size": 32,
    "num_workers": 2
  },
  "training": {
    "max_epochs": 3,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "early_stopping_patience": 2,
    "seed": 42,
    "device": "auto",
    "checkpoint_dir": "models/v2_expanded_data",
    "class_weights": "balanced"
  }
}